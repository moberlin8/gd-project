# Lemieux GD RAT bot — environment template
# Copy to bot/.env (gitignored) and fill in.

# ── Discord (lembot_discord.py) ──────────────────────────────────────────────
# Developer Portal → New Application "Lemieux" → Bot → Reset Token.
# Enable MESSAGE CONTENT INTENT. Invite with scopes: bot; perms: View Channels,
# Send Messages, Read Message History.
LEMIEUX_DISCORD_TOKEN=paste-token-here

# Channel IDs where Lemieux answers every message (comma-separated).
# Right-click channel → Copy Channel ID (Developer Mode must be on).
# He also answers @mentions in any channel he can read.
LEMIEUX_CHANNEL_IDS=123456789012345678

# ── LLM for synthesized answers (optional; falls back to raw matches) ────────
# Left unset, start_lembot_discord.sh copies XAI_API_KEY from ~/.hermes/.env.
# XAI_API_KEY=xai-...
# LEMIEUX_LLM_MODEL=grok-4.3
# LEMIEUX_LLM_BASE_URL=https://api.x.ai/v1

# ── Telegram (lembot_telegram.py) ────────────────────────────────────────────
# LEMIEUX_TELEGRAM_TOKEN=123456789:AAABotTokenFromBotFatherHere
